# Server (NestJS) — copy to .env and fill secrets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interactive_storytelling?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Explicit local mode only: STORAGE_MODE=file (no PostgreSQL required)
STORAGE_MODE=database
# Optional admin provisioning on first start. Use a unique email and strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
